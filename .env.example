# Copy this file to .env and adjust URLs by environment
VITE_API_BASE_URL=
VITE_API_REALTIME_CONFIG=/mock-api/config/realtime.json

VITE_API_GAME_LOTTO_ACTIVO=/mock-api/games/lotto-activo.json
VITE_API_GAME_LOTTO_INTER=/mock-api/games/lotto-inter.json
VITE_API_GAME_MONJE_MILLONARIO=/mock-api/games/monje-millonario.json

VITE_API_PRODUCTS_LIST=/mock-api/products/list.json
VITE_API_PRODUCTS_CATALOG=/mock-api/products/catalog.json
VITE_API_PRODUCTS_PRICING=/mock-api/products/pricing.json
VITE_API_PRODUCTS_AVAILABILITY=/mock-api/products/availability.json

# Lotto Activo official API integration
# Use the same-origin proxy path in browser environments to avoid CORS failures.
VITE_LOTTO_ACTIVO_API_URL=/lotto-api/api.php
VITE_LOTTO_ACTIVO_API_USER=pagosrapidos
VITE_LOTTO_ACTIVO_API_PASS=123456P*
# Optional. If left empty, the monitor uses today's date by default.
VITE_LOTTO_ACTIVO_API_DATE=
VITE_LOTTO_ACTIVO_API_ENABLED=true
VITE_LOTTO_ACTIVO_API_MIN_INTERVAL_MS=5000
